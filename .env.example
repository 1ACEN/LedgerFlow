# LedgerFlow Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# STRIPE (Required for production ingestion)
# =============================================================================
# Get from Stripe Dashboard > Developers > API keys
# Test mode: sk_test_... (safe for development)
# Live mode: sk_live_... (production only)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_ACCOUNT_ID=acct_your_account_id  # Your Stripe account ID (for Connect)

# =============================================================================
# PLAID (Required for bank feed ingestion)
# =============================================================================
# Get from Plaid Dashboard > Team Settings > Keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox  # sandbox, development, or production
# Comma-separated access tokens from Link flow
PLAID_ACCESS_TOKENS=access-sandbox-xxx,access-sandbox-yyy

# =============================================================================
# DATABASE
# =============================================================================
# Local development (DuckDB file)
DUCKDB_PATH=data/ledgerflow.duckdb

# Production (PostgreSQL on Fly.io)
# DATABASE_URL=postgresql://user:pass@host:5432/ledgerflow

# =============================================================================
# ML MODEL REGISTRY
# =============================================================================
MODEL_REGISTRY_PATH=models/

# =============================================================================
# DEPLOYMENT (Fly.io)
# =============================================================================
# Set via: fly secrets set KEY=value
# FLY_APP_NAME=ledgerflow

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================
# Sentry for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Slack webhook for alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Generate synthetic data on container start (dev only)
GENERATE_SYNTHETIC=true

# Log level
LOG_LEVEL=INFO