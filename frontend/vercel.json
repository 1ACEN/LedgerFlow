{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/reports/:path*",
      "destination": "https://ledgerflow.onrender.com/reports/:path*"
    },
    {
      "source": "/stats/:path*",
      "destination": "https://ledgerflow.onrender.com/stats/:path*"
    },
    {
      "source": "/transactions/:path*",
      "destination": "https://ledgerflow.onrender.com/transactions/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ledgerflow.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
